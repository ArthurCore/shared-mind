{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shared-mind.local/schemas/context-benchmark-certification.schema.v1.json",
  "title": "Shared Mind Context Benchmark Certification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "certification_version",
    "implementation_id",
    "profile",
    "requested_ledger_entries",
    "schema_version",
    "projection_version",
    "fixture_version",
    "benchmark_version",
    "fixture",
    "databases",
    "timings_ns",
    "verification",
    "replay",
    "context",
    "environment",
    "certified",
    "certification_hash"
  ],
  "properties": {
    "certification_version": {"const": "context-benchmark-certification@1"},
    "implementation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "profile": {"enum": ["history-heavy", "hot-active"]},
    "requested_ledger_entries": {"type": "integer", "minimum": 1},
    "schema_version": {"const": "1.3.0"},
    "projection_version": {"type": "string", "minLength": 1},
    "fixture_version": {"const": "dev-021-fixture@1"},
    "benchmark_version": {"const": "dev-021-context-benchmark@1"},
    "fixture": {"$ref": "#/$defs/fixture"},
    "databases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "replay"],
      "properties": {
        "source": {"$ref": "#/$defs/databaseEvidence"},
        "replay": {"$ref": "#/$defs/databaseEvidence"}
      }
    },
    "timings_ns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "verification", "replay", "context"],
      "properties": {
        "generation": {"type": "integer", "minimum": 0},
        "verification": {"type": "integer", "minimum": 0},
        "replay": {"type": "integer", "minimum": 0},
        "context": {"type": "integer", "minimum": 0}
      }
    },
    "verification": {"$ref": "#/$defs/verification"},
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parity", "source", "target"],
      "properties": {
        "parity": {"const": true},
        "source": {"$ref": "#/$defs/snapshot"},
        "target": {"$ref": "#/$defs/snapshot"}
      }
    },
    "context": {"$ref": "#/$defs/context"},
    "environment": {"$ref": "#/$defs/environment"},
    "certified": {"type": "boolean"},
    "certification_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "databaseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size_bytes"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "tableCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "claims",
        "evidence",
        "conflicts",
        "decision_records",
        "open_questions",
        "work_items",
        "ledger",
        "receipts"
      ],
      "properties": {
        "sources": {"type": "integer", "minimum": 0},
        "claims": {"type": "integer", "minimum": 0},
        "evidence": {"type": "integer", "minimum": 0},
        "conflicts": {"type": "integer", "minimum": 0},
        "decision_records": {"type": "integer", "minimum": 0},
        "open_questions": {"type": "integer", "minimum": 0},
        "work_items": {"type": "integer", "minimum": 0},
        "ledger": {"type": "integer", "minimum": 1},
        "receipts": {"type": "integer", "minimum": 1}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_version",
        "profile",
        "seed",
        "generation_api",
        "schema_version",
        "projection_version",
        "ledger_entries",
        "head_entry_hash",
        "state_root",
        "table_counts",
        "hot_object",
        "manifest_hash"
      ],
      "properties": {
        "fixture_version": {"const": "dev-021-fixture@1"},
        "profile": {"enum": ["history-heavy", "hot-active"]},
        "seed": {"type": "integer", "minimum": 0},
        "generation_api": {"const": "Kernel.commit"},
        "schema_version": {"const": "1.3.0"},
        "projection_version": {"type": "string", "minLength": 1},
        "ledger_entries": {"type": "integer", "minimum": 1},
        "head_entry_hash": {"$ref": "#/$defs/sha256"},
        "state_root": {"$ref": "#/$defs/sha256"},
        "table_counts": {"$ref": "#/$defs/tableCounts"},
        "hot_object": {
          "type": "object",
          "additionalProperties": false,
          "required": ["object_type", "object_id", "history_entries", "status"],
          "properties": {
            "object_type": {"const": "WORK_ITEM"},
            "object_id": {"type": "string", "minLength": 1},
            "history_entries": {"type": "integer", "minimum": 1},
            "status": {"enum": ["TODO", "DOING", "DONE"]}
          }
        },
        "manifest_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger_count",
        "receipt_count",
        "head_sequence",
        "head_hash",
        "state_root",
        "receipt_schema_versions"
      ],
      "properties": {
        "ledger_count": {"type": "integer", "minimum": 1},
        "receipt_count": {"type": "integer", "minimum": 1},
        "head_sequence": {"type": "integer", "minimum": 1},
        "head_hash": {"$ref": "#/$defs/sha256"},
        "state_root": {"$ref": "#/$defs/sha256"},
        "receipt_schema_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "checked_entries", "head_hash", "state_root", "errors"],
      "properties": {
        "valid": {"const": true},
        "checked_entries": {"type": "integer", "minimum": 1},
        "head_hash": {"$ref": "#/$defs/sha256"},
        "state_root": {"$ref": "#/$defs/sha256"},
        "errors": {"type": "array", "maxItems": 0}
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_count", "min_ns", "median_ns", "p95_ns", "max_ns"],
      "properties": {
        "sample_count": {"type": "integer", "minimum": 1},
        "min_ns": {"type": "integer", "minimum": 0},
        "median_ns": {"type": "number", "minimum": 0},
        "p95_ns": {"type": "integer", "minimum": 0},
        "max_ns": {"type": "integer", "minimum": 0}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "sqlite", "platform"],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "sqlite": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_version",
        "metric",
        "clock",
        "p95_method",
        "warmup_count",
        "budget_bytes",
        "context_sha256",
        "context_rendered_bytes",
        "target_p95_ns",
        "target_met",
        "latency",
        "samples_ns",
        "environment"
      ],
      "properties": {
        "benchmark_version": {"const": "dev-021-context-benchmark@1"},
        "metric": {"const": "warm-filesystem-library-context"},
        "clock": {"const": "time.perf_counter_ns"},
        "p95_method": {"const": "nearest-rank"},
        "warmup_count": {"type": "integer", "minimum": 1},
        "budget_bytes": {"type": "integer", "minimum": 1},
        "context_sha256": {"$ref": "#/$defs/sha256"},
        "context_rendered_bytes": {"type": "integer", "minimum": 1},
        "target_p95_ns": {"type": "integer", "minimum": 1},
        "target_met": {"type": "boolean"},
        "latency": {"$ref": "#/$defs/latency"},
        "samples_ns": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0}
        },
        "environment": {"$ref": "#/$defs/environment"}
      }
    }
  }
}
