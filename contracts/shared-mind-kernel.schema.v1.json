{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shared-mind.local/schema/kernel/v1",
  "title": "Shared Mind Kernel Contract v1",
  "description": "Shape contract for the Atlas epistemic transaction kernel. Cross-object and hashing invariants are enforced by the semantic validator.",
  "oneOf": [
    {"$ref": "#/$defs/PredicateRegistry"},
    {"$ref": "#/$defs/SourceRevision"},
    {"$ref": "#/$defs/Claim"},
    {"$ref": "#/$defs/EvidenceLink"},
    {"$ref": "#/$defs/DecisionRecord"},
    {"$ref": "#/$defs/OpenQuestion"},
    {"$ref": "#/$defs/WorkItem"},
    {"$ref": "#/$defs/Proposal"},
    {"$ref": "#/$defs/Conflict"},
    {"$ref": "#/$defs/LedgerEntry"},
    {"$ref": "#/$defs/DecisionReceipt"}
  ],
  "$defs": {
    "Hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "SemanticId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,31}:[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "RecordId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,31}_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
    },
    "SemVer": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "ActorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "actor_type"],
      "properties": {
        "actor_id": {"$ref": "#/$defs/SemanticId"},
        "actor_type": {"enum": ["AGENT", "HUMAN", "SERVICE"]}
      }
    },
    "EntityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "entity_type"],
      "properties": {
        "entity_id": {"$ref": "#/$defs/SemanticId"},
        "entity_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      }
    },
    "ObjectValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "entity_id", "entity_type"],
          "properties": {
            "kind": {"const": "entity"},
            "entity_id": {"$ref": "#/$defs/SemanticId"},
            "entity_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "string"},
            "value": {"type": "string", "minLength": 1, "maxLength": 4096}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "number"},
            "value": {"type": "number"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "boolean"},
            "value": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "enum"},
            "value": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}
          }
        }
      ]
    },
    "ScopeV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "environment", "region", "tenant"],
      "properties": {
        "component": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "environment": {"type": ["string", "null"], "minLength": 1, "maxLength": 64},
        "region": {"type": ["string", "null"], "minLength": 1, "maxLength": 64},
        "tenant": {"type": ["string", "null"], "minLength": 1, "maxLength": 128}
      }
    },
    "ValidTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"type": ["string", "null"], "format": "date-time"},
        "to": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "Proposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposition_version", "subject", "predicate", "object", "polarity", "scope", "valid_time"],
      "properties": {
        "proposition_version": {"const": 1},
        "subject": {"$ref": "#/$defs/EntityRef"},
        "predicate": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*@[1-9][0-9]*$"},
        "object": {"$ref": "#/$defs/ObjectValue"},
        "polarity": {"enum": ["POSITIVE", "NEGATIVE"]},
        "scope": {"$ref": "#/$defs/ScopeV1"},
        "valid_time": {"$ref": "#/$defs/ValidTime"}
      }
    },
    "SourceRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "source_id", "revision_id", "content_hash", "blob_ref", "media_type", "captured_at", "registered_by"],
      "properties": {
        "object_type": {"const": "SOURCE_REVISION"},
        "source_id": {"$ref": "#/$defs/SemanticId"},
        "revision_id": {"$ref": "#/$defs/RecordId"},
        "content_hash": {"$ref": "#/$defs/Hash"},
        "blob_ref": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^data:[^,]*,.*$"
            },
            {
              "type": "string",
              "format": "uri",
              "maxLength": 2048,
              "not": {"pattern": "^data:"}
            }
          ]
        },
        "source_locator": {"type": ["string", "null"], "format": "uri", "maxLength": 2048},
        "title": {"type": ["string", "null"], "maxLength": 512},
        "media_type": {"enum": ["text/markdown", "text/plain", "application/json"]},
        "captured_at": {"type": "string", "format": "date-time"},
        "registered_by": {"$ref": "#/$defs/ActorRef"}
      }
    },
    "Claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "claim_id", "proposition_hash", "proposition", "asserted_by", "asserted_at"],
      "properties": {
        "object_type": {"const": "CLAIM"},
        "claim_id": {"$ref": "#/$defs/RecordId"},
        "proposition_hash": {"$ref": "#/$defs/Hash"},
        "proposition": {"$ref": "#/$defs/Proposition"},
        "asserted_by": {"$ref": "#/$defs/ActorRef"},
        "asserted_at": {"type": "string", "format": "date-time"}
      }
    },
    "TextSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "start_byte", "end_byte", "excerpt", "excerpt_hash", "prefix_hash", "suffix_hash"],
      "properties": {
        "kind": {"const": "TEXT_BYTE_RANGE"},
        "start_byte": {"type": "integer", "minimum": 0},
        "end_byte": {"type": "integer", "minimum": 1},
        "excerpt": {"type": "string", "minLength": 1, "maxLength": 16384},
        "excerpt_hash": {"$ref": "#/$defs/Hash"},
        "prefix_hash": {
          "oneOf": [{"$ref": "#/$defs/Hash"}, {"type": "null"}]
        },
        "suffix_hash": {
          "oneOf": [{"$ref": "#/$defs/Hash"}, {"type": "null"}]
        }
      }
    },
    "EvidenceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "evidence_link_id", "claim_id", "source_revision_id", "selector", "stance", "interpretation", "linked_by", "linked_at"],
      "properties": {
        "object_type": {"const": "EVIDENCE_LINK"},
        "evidence_link_id": {"$ref": "#/$defs/RecordId"},
        "claim_id": {"$ref": "#/$defs/RecordId"},
        "source_revision_id": {"$ref": "#/$defs/RecordId"},
        "selector": {"$ref": "#/$defs/TextSelector"},
        "stance": {"enum": ["SUPPORTS", "CHALLENGES", "MENTIONS"]},
        "interpretation": {"enum": ["DIRECT", "REPORTED", "INFERRED"]},
        "linked_by": {"$ref": "#/$defs/ActorRef"},
        "linked_at": {"type": "string", "format": "date-time"}
      }
    },
    "RecordRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "record_id"],
      "properties": {
        "record_type": {
          "enum": ["SOURCE_REVISION", "CLAIM", "CONFLICT", "DECISION_RECORD", "OPEN_QUESTION", "WORK_ITEM"]
        },
        "record_id": {"$ref": "#/$defs/RecordId"}
      }
    },
    "DecisionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "decision_id", "title", "conclusion", "rationale", "alternatives", "related_source_revision_ids", "related_claim_ids", "status", "version", "replaced_by_decision_id", "recorded_by", "recorded_at"],
      "properties": {
        "object_type": {"const": "DECISION_RECORD"},
        "decision_id": {"$ref": "#/$defs/RecordId"},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "conclusion": {"type": "string", "minLength": 1, "maxLength": 8192},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 8192},
        "alternatives": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        },
        "related_source_revision_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/RecordId"}
        },
        "related_claim_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/RecordId"}
        },
        "status": {"enum": ["ACTIVE", "SUPERSEDED", "REVERSED"]},
        "version": {"type": "integer", "minimum": 1},
        "replaced_by_decision_id": {
          "oneOf": [{"$ref": "#/$defs/RecordId"}, {"type": "null"}]
        },
        "recorded_by": {"$ref": "#/$defs/ActorRef"},
        "recorded_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "ACTIVE"}}},
          "then": {"properties": {"replaced_by_decision_id": {"type": "null"}}}
        },
        {
          "if": {"properties": {"status": {"enum": ["SUPERSEDED", "REVERSED"]}}},
          "then": {"properties": {"replaced_by_decision_id": {"$ref": "#/$defs/RecordId"}}}
        }
      ]
    },
    "NewDecisionRecord": {
      "allOf": [
        {"$ref": "#/$defs/DecisionRecord"},
        {
          "properties": {
            "status": {"const": "ACTIVE"},
            "version": {"const": 1},
            "replaced_by_decision_id": {"type": "null"}
          }
        }
      ]
    },
    "QuestionAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answer", "answer_reference", "answered_by", "answered_at"],
      "properties": {
        "answer": {"type": "string", "minLength": 1, "maxLength": 8192},
        "answer_reference": {"$ref": "#/$defs/RecordRef"},
        "answered_by": {"$ref": "#/$defs/ActorRef"},
        "answered_at": {"type": "string", "format": "date-time"}
      }
    },
    "QuestionDrop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rationale", "dropped_by", "dropped_at"],
      "properties": {
        "rationale": {"type": "string", "minLength": 1, "maxLength": 4096},
        "dropped_by": {"$ref": "#/$defs/ActorRef"},
        "dropped_at": {"type": "string", "format": "date-time"}
      }
    },
    "OpenQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "question_id", "question", "context", "related_objects", "status", "version", "answer", "drop", "opened_by", "opened_at"],
      "properties": {
        "object_type": {"const": "OPEN_QUESTION"},
        "question_id": {"$ref": "#/$defs/RecordId"},
        "question": {"type": "string", "minLength": 1, "maxLength": 4096},
        "context": {"type": "string", "minLength": 1, "maxLength": 8192},
        "related_objects": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/RecordRef"}
        },
        "status": {"enum": ["OPEN", "ANSWERED", "DROPPED"]},
        "version": {"type": "integer", "minimum": 1},
        "answer": {
          "oneOf": [{"$ref": "#/$defs/QuestionAnswer"}, {"type": "null"}]
        },
        "drop": {
          "oneOf": [{"$ref": "#/$defs/QuestionDrop"}, {"type": "null"}]
        },
        "opened_by": {"$ref": "#/$defs/ActorRef"},
        "opened_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "OPEN"}}},
          "then": {"properties": {"answer": {"type": "null"}, "drop": {"type": "null"}}}
        },
        {
          "if": {"properties": {"status": {"const": "ANSWERED"}}},
          "then": {"properties": {"answer": {"$ref": "#/$defs/QuestionAnswer"}, "drop": {"type": "null"}}}
        },
        {
          "if": {"properties": {"status": {"const": "DROPPED"}}},
          "then": {"properties": {"answer": {"type": "null"}, "drop": {"$ref": "#/$defs/QuestionDrop"}}}
        }
      ]
    },
    "NewOpenQuestion": {
      "allOf": [
        {"$ref": "#/$defs/OpenQuestion"},
        {
          "properties": {
            "status": {"const": "OPEN"},
            "version": {"const": 1},
            "answer": {"type": "null"},
            "drop": {"type": "null"}
          }
        }
      ]
    },
    "WorkItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "work_item_id", "description", "priority", "blocker", "related_objects", "status", "version", "created_by", "created_at", "updated_at"],
      "properties": {
        "object_type": {"const": "WORK_ITEM"},
        "work_item_id": {"$ref": "#/$defs/RecordId"},
        "description": {"type": "string", "minLength": 1, "maxLength": 8192},
        "priority": {"enum": ["P0", "P1", "P2", "P3"]},
        "blocker": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096},
        "related_objects": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/RecordRef"}
        },
        "status": {"enum": ["TODO", "DOING", "BLOCKED", "DONE", "DROPPED"]},
        "version": {"type": "integer", "minimum": 1},
        "created_by": {"$ref": "#/$defs/ActorRef"},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "BLOCKED"}}},
          "then": {"properties": {"blocker": {"type": "string"}}}
        },
        {
          "if": {"properties": {"status": {"enum": ["TODO", "DOING", "DONE", "DROPPED"]}}},
          "then": {"properties": {"blocker": {"type": "null"}}}
        }
      ]
    },
    "NewWorkItem": {
      "allOf": [
        {"$ref": "#/$defs/WorkItem"},
        {
          "properties": {
            "status": {"const": "TODO"},
            "version": {"const": 1},
            "blocker": {"type": "null"}
          }
        }
      ]
    },
    "PredicateObjectDefinition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "entity_types"],
          "properties": {
            "kind": {"const": "entity"},
            "entity_types": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "enum_values"],
          "properties": {
            "kind": {"const": "enum"},
            "enum_values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"enum": ["string", "number", "boolean"]}}
        }
      ]
    },
    "PredicateDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "description", "subject_types", "object", "scope", "temporal", "cardinality", "family_key_fields", "conflict_rules", "evidence_policy"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*@[1-9][0-9]*$"},
        "description": {"type": "string", "minLength": 1, "maxLength": 1024},
        "subject_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}
        },
        "object": {"$ref": "#/$defs/PredicateObjectDefinition"},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed_fields", "required_fields"],
          "properties": {
            "allowed_fields": {
              "type": "array",
              "uniqueItems": true,
              "items": {"enum": ["component", "environment", "region", "tenant"]}
            },
            "required_fields": {
              "type": "array",
              "uniqueItems": true,
              "items": {"enum": ["component", "environment", "region", "tenant"]}
            }
          }
        },
        "temporal": {"enum": ["REQUIRED", "OPTIONAL", "FORBIDDEN"]},
        "cardinality": {"enum": ["ONE", "MANY"]},
        "family_key_fields": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{0,127}$"}
        },
        "conflict_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "rule_version"],
            "properties": {
              "kind": {"enum": ["OPPOSITE_POLARITY", "EXCLUSIVE_OBJECT", "TEMPORAL_OVERLAP"]},
              "rule_version": {"type": "string", "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"}
            }
          }
        },
        "evidence_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum_evidence_links", "allowed_interpretations"],
          "properties": {
            "minimum_evidence_links": {"type": "integer", "minimum": 0, "maximum": 16},
            "allowed_interpretations": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["DIRECT", "REPORTED", "INFERRED"]}
            }
          }
        }
      }
    },
    "PredicateRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "registry_id", "version", "canonicalization_version", "guard_dsl_version", "entity_types", "scope_fields", "predicates"],
      "properties": {
        "object_type": {"const": "PREDICATE_REGISTRY"},
        "registry_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$"},
        "version": {"$ref": "#/$defs/SemVer"},
        "canonicalization_version": {"type": "string", "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"},
        "guard_dsl_version": {"type": "string", "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"},
        "entity_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}
        },
        "scope_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["component", "environment", "region", "tenant"]}
        },
        "predicates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/PredicateDefinition"}
        }
      }
    },
    "AggregateRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "aggregate_type", "aggregate_id", "expected_version"],
      "properties": {
        "kind": {"const": "AGGREGATE"},
        "aggregate_type": {"enum": ["CLAIM", "CONFLICT", "SOURCE_REVISION", "DECISION_RECORD", "OPEN_QUESTION", "WORK_ITEM"]},
        "aggregate_id": {"$ref": "#/$defs/RecordId"},
        "expected_version": {"type": "integer", "minimum": 0}
      }
    },
    "CollectionRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "family_key", "expected_digest"],
      "properties": {
        "kind": {"const": "COLLECTION"},
        "family_key": {"$ref": "#/$defs/Hash"},
        "expected_digest": {"$ref": "#/$defs/Hash"}
      }
    },
    "ReadRef": {
      "oneOf": [
        {"$ref": "#/$defs/AggregateRead"},
        {"$ref": "#/$defs/CollectionRead"}
      ]
    },
    "Guard": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "claim_id", "expected_status"],
          "properties": {
            "op": {"const": "CLAIM_STATUS_EQ"},
            "claim_id": {"$ref": "#/$defs/RecordId"},
            "expected_status": {"enum": ["ACTIVE", "SUPERSEDED", "RETRACTED"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "claim_id", "expected_version"],
          "properties": {
            "op": {"const": "CLAIM_VERSION_EQ"},
            "claim_id": {"$ref": "#/$defs/RecordId"},
            "expected_version": {"type": "integer", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "conflict_id", "expected_status"],
          "properties": {
            "op": {"const": "CONFLICT_STATUS_EQ"},
            "conflict_id": {"$ref": "#/$defs/RecordId"},
            "expected_status": {"enum": ["OPEN", "RESOLVED"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "conflict_id", "expected_digest"],
          "properties": {
            "op": {"const": "CONFLICT_MEMBER_DIGEST_EQ"},
            "conflict_id": {"$ref": "#/$defs/RecordId"},
            "expected_digest": {"$ref": "#/$defs/Hash"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "family_key", "expected_digest"],
          "properties": {
            "op": {"const": "ACTIVE_SET_DIGEST_EQ"},
            "family_key": {"$ref": "#/$defs/Hash"},
            "expected_digest": {"$ref": "#/$defs/Hash"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "source_revision_id", "expected_hash"],
          "properties": {
            "op": {"const": "SOURCE_HASH_EQ"},
            "source_revision_id": {"$ref": "#/$defs/RecordId"},
            "expected_hash": {"$ref": "#/$defs/Hash"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "family_key"],
          "properties": {
            "op": {"const": "NO_ACTIVE_CLAIM"},
            "family_key": {"$ref": "#/$defs/Hash"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "decision_id", "expected_status"],
          "properties": {
            "op": {"const": "DECISION_STATUS_EQ"},
            "decision_id": {"$ref": "#/$defs/RecordId"},
